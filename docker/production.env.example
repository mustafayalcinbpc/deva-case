# Production ortam dosyası şablonu (compose.prod.yaml). Kullanım:
#   cp docker/production.env.example .env.production     # .env.production git'e girmez
#   # aşağıdaki boş değerleri doldurun
#   docker compose -f compose.prod.yaml --env-file .env.production up -d --build
#
# Bu dosya iki yerde okunur: --env-file ile compose değişkenleri (port, parolalar) ve
# env_file ile uygulama container'larının ortamı (APP_URL, DEMO_SEED, MAIL_*...).
# APP_ENV=production, APP_DEBUG=false ve servis adresleri compose.prod.yaml'da sabittir.

# Uygulama anahtarı; bir kez üretilir ve saklanır (değişirse oturumlar ve şifreli veriler açılamaz):
#   echo "base64:$(openssl rand -base64 32)"
APP_KEY=
APP_URL=http://localhost

# nginx'in dinlediği host portu
HTTP_PORT=80

DB_DATABASE=temizlik
DB_USERNAME=temizlik
DB_PASSWORD=

RABBITMQ_USER=temizlik
RABBITMQ_PASSWORD=

# Boş veritabanına demo verisi yüklensin mi (yalnızca tanıtım kurulumu için)
DEMO_SEED=false

LOG_STACK=daily
LOG_LEVEL=info

# TLS sonlandıran bir proxy arkasındaysa
# SESSION_SECURE_COOKIE=true

MAIL_MAILER=log
